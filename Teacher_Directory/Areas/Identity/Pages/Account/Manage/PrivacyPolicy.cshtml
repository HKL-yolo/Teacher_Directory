@page
@model PrivacyPolicyModel
@{
    ViewData["Title"] = "Privacy Policy";
    ViewData["ActivePage"] = ManageNavPages.PrivacyPolicy;
    
}

<h3>@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-6">
        <a href="~/Privacy Policy/Privacy Policy.pdf" target="_blank">
            Check Privacy Policy
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
