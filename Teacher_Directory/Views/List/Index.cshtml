@model Teacher_Directory.ViewModels.TeacherSubjectViewModels

@{
    ViewData["Title"] = "Teacher Directory";
}

<div class="container mt-4">

    ```
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold text-primary">
                Teacher Directory
            </h1>

            <p class="text-muted">
                Browse teachers and course information
            </p>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="Create" class="btn btn-primary">
                + Add Course
            </a>
        }

    </div>

    <!-- Search -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="input-group">

                    <input type="text"
                           name="searchString"
                           class="form-control"
                           placeholder="Search teacher or subject..." />

                    <button type="submit"
                            class="btn btn-primary">
                        Search
                    </button>

                </div>

            </form>

        </div>

    </div>

    <!-- Table -->
    <div class="card shadow border-0">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-primary">

                        <tr>

                            <th>
                                Teacher
                            </th>

                            <th>
                                Room
                            </th>

                            <th>
                                Year
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Subject
                            </th>

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <th>
                                    Actions
                                </th>
                            }

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.Teachers)
                        {
                            <tr>

                                <!-- Teacher -->
                                <td>

                                    <a href="#"
                                       class="teacher-link text-decoration-none"
                                       data-bs-toggle="modal"
                                       data-bs-target="#myModal-@item.Id">

                                        <div class="d-flex align-items-center">

                                            @if (!string.IsNullOrEmpty(item.PhotoURL))
                                            {
                                                <img src="@item.PhotoURL"
                                                     style="
                                                width:45px;
                                                height:45px;
                                                border-radius:50%;
                                                object-fit:cover;
                                                margin-right:10px;" />
                                            }

                                            <span class="fw-semibold">
                                                @item.FullName
                                            </span>

                                        </div>

                                    </a>

                                </td>

                                <!-- Room -->
                                    <td>
                                        @foreach (var c in item.Course ?? Enumerable.Empty<Course>())
                                        {
                                            <div>@c.Room_Num</div>
                                        }
                                    </td>

                                <!-- Year -->
                                <td>
                                    @foreach (var c in item.Course ?? Enumerable.Empty<Course>())
                                    {
                                        <div>@c.Year</div>
                                    }
                                </td>

                                <!-- Email -->
                                <td>
                                    @item.Email
                                </td>

                                <!-- Subject -->
                                <td>

                                    <span class="badge bg-primary">

                                        @item.SubjectName

                                    </span>

                                </td> 
                                <td>
                                        @foreach (var c in item.Course ?? Enumerable.Empty<Course>())
                                        {
                                            <span class="badge bg-primary">

                                        @c.SubjectName

                                    </span>
                                        }
                                    </td>
                               

                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <td>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            Details
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>

                                    </td>
                                }

                            </tr>

                            <!-- Modal -->
                            <div class="modal fade"
                                 id="myModal-@item.Id"
                                 tabindex="-1">

                                <div class="modal-dialog modal-lg modal-dialog-centered">

                                    <div class="modal-content shadow">

                                        <div class="modal-header bg-primary text-white">

                                            <h4 class="modal-title">

                                                Teacher Details

                                            </h4>

                                            <button type="button"
                                                    class="btn-close btn-close-white"
                                                    data-bs-dismiss="modal">
                                            </button>

                                        </div>

                                        <div class="modal-body">

                                            <div class="container">

                                                <div class="row">

                                                    <!-- Photo -->
                                                    <div class="col-md-4 text-center">

                                                        @if (!string.IsNullOrEmpty(item.PhotoURL))
                                                        {
                                                            <img src="@item.PhotoURL"
                                                                 class="img-fluid rounded-circle border border-3 border-primary"
                                                                 style="
                                                            width:180px;
                                                            height:180px;
                                                            object-fit:cover;" />
                                                        }
                                                        else
                                                        {
                                                            <div class="text-muted">
                                                                No Photo
                                                            </div>
                                                        }

                                                    </div>

                                                    <!-- Details -->
                                                    <div class="col-md-8">

                                                        <h2 class="fw-bold text-primary">

                                                            @item.FullName

                                                        </h2>

                                                        <hr />

                                                        <p>
                                                            <strong>Email:</strong>
                                                            @item.Email
                                                        </p>

                                                        <p>
                                                            <strong>Position:</strong>
                                                            @item.Position
                                                        </p>

                                                        <p>
                                                            <strong>Gender:</strong>
                                                            @item.Gender
                                                        </p>

                                                        @* <p>
                                                            <strong>Room:</strong>
                                                            @item.Course.Room_Num
                                                        </p>

                                                        <p>
                                                            <strong>Year:</strong>
                                                            @item.Year
                                                        </p>

                                                        <p>
                                                            <strong>Subject:</strong>
                                                            @item.Subject?.SubjectName
                                                        </p> *@

                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                        <div class="modal-footer">

                                            <button type="button"
                                                    class="btn btn-secondary"
                                                    data-bs-dismiss="modal">

                                                Close

                                            </button>

                                        </div>

                                    </div>

                                </div>

                            </div>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

