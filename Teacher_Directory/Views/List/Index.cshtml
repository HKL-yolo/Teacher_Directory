@model Teacher_Directory.ViewModels.TeacherSubjectViewModels

@{
    ViewData["Title"] = "Teacher Directory";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold text-primary">
                Teacher Directory
            </h1>

            <p class="text-muted">
                Find teachers by name or department.
            </p>
        </div>


    </div>

    <!-- Search -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="input-group">

                    <input type="text" name="searchString" class="form-control"
                           placeholder="Search teacher or department..." />

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Search
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Clear
                    </a>

                </div>

            </form>

        </div>

    </div>

    <div class=" mb-2">

        @foreach (var departmentGroup in Model.Teachers
        .OrderBy(t => t.Department?.DepartmentName)
        .GroupBy(t => t.Department?.DepartmentName ?? "No Department"))
        {
            <div class="mb-3">

                <h3>@departmentGroup.Key Department</h3>
                <hr />

                <div class="row g-2">
                    @foreach (var teacher in departmentGroup.OrderBy(t => t.FullName))
                    {
                        <div class="col-lg-3 col-md-4 col-sm-6 ">
                            <div class="card teacher-card h-100 w-100">

                                @if (!string.IsNullOrEmpty(teacher.PhotoURL))
                                {
                                    <img src="@teacher.PhotoURL" class="card-img-top" style="height:250px; object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="d-flex justify-content-center align-items-center bg-light" style="height:250px;">
                                        No Photo
                                    </div>
                                }

                                <div class="card-body text-center">
                                    <h5 class="card-title">@teacher.FullName</h5>
                                    <p class="card-text">@teacher.Position</p>
                                    <div>
                                        <a href="#" class="text-decoration-none" data-bs-toggle="modal"
                                           data-bs-target="#emailModal"">
                                            ✉️
                                        </a> |
                                        <a href=" #" class="teacher-link text-decoration-none" data-bs-toggle="modal"
                                           data-bs-target="#myModal-@teacher.Id"> View More </a>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- Modal -->
                        <div class="modal fade" id="myModal-@teacher.Id" tabindex="-1">

                            <div class="modal-dialog modal-lg modal-dialog-centered">

                                <div class="modal-content shadow">

                                    <div class="modal-header bg-primary text-white">

                                        <h4 class="modal-title">

                                            Teacher Details

                                        </h4>

                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal">
                                        </button>

                                    </div>

                                    <div class="modal-body">

                                        <div class="container">

                                            <div class="row">

                                                <!-- Photo -->
                                                <div class="col-md-4 text-center">

                                                    @if (!string.IsNullOrEmpty(teacher.PhotoURL))
                                                    {
                                                        <img src="@teacher.PhotoURL"
                                                             class="img-fluid rounded-circle border border-3 border-primary" style="
                                                        width:180px;
                                                        height:180px;
                                                        object-fit:cover;" />
                                                    }
                                                    else
                                                    {
                                                        <div class="text-muted">
                                                            No Photo
                                                        </div>
                                                    }

                                                </div>

                                                <!-- Details -->
                                                <div class="col-md-8">

                                                    <h2 class="fw-bold text-primary">
                                                        @teacher.FullName
                                                    </h2>

                                                    <hr />

                                                    <p>
                                                        <strong>Email:</strong>
                                                        @teacher.Email
                                                    </p>

                                                    <p>
                                                        <strong>Position:</strong>
                                                        @teacher.Position
                                                    </p>

                                                    <p>
                                                        <strong>Gender:</strong>
                                                        @teacher.Gender
                                                    </p>

                                                    <p>
                                                        <strong>Offlice:</strong>
                                                        @teacher.OfficeLocation
                                                    </p>

                                                    <div class="mt-3">
                                                        <h4>Teaching Assignments</h4>
                                                        <table class="table align-middle">
                                                            <thead class="table-primary">
                                                                <tr>
                                                                    <th>Course</th>
                                                                    <th>Subject</th>
                                                                    <th>Year</th>
                                                                    <th>Room</th>
                                                                </tr>
                                                            </thead>

                                                            <tbody>
                                                                @if (@teacher.Course != null && @teacher.Course.Any())
                                                                {
                                                                    @foreach (var course in @teacher.Course)
                                                                    {
                                                                        <tr>
                                                                            <td>@course.CourseName</td>
                                                                            <td>@course.Subject?.SubjectName</td>
                                                                            <td>@course.Year</td>
                                                                            <td>@course.Room_Num</td>
                                                                        </tr>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <tr>
                                                                        <td colspan="4" class="text-center text-muted">
                                                                            No teaching assignments found.
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="modal-footer">

                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">

                                            Close

                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="modal fade" id="emailModal" tabindex="-1">
                            <div class="modal-dialog">
                                <div class="modal-content">

                                    <div class="modal-header bg-primary text-white">
                                        <h5 class="modal-title">Send Email</h5>

                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal">
                                        </button>
                                    </div>

                                    <div class="modal-body">

                                        <div class="mb-3">
                                            <label class="form-label">To</label>
                                            <input id="emailTo" class="form-control" value=@teacher.Email readonly />
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Subject</label>
                                            <input class="form-control" placeholder="Subject" />
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Message</label>

                                            <textarea class="form-control" rows="6"
                                                      placeholder="Write your message..."></textarea>
                                        </div>

                                    </div>

                                    <div class="modal-footer">

                                        <button class="btn btn-secondary" data-bs-dismiss="modal">
                                            Cancel
                                        </button>

                                        <button class="btn btn-primary">
                                            Send
                                        </button>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                </div>

            </div>
        }

    
    </div>
</div>