@model IEnumerable<Teacher_Directory.Models.Course>

@{
    ViewData["Title"] = "Index";
}

<h1>Teacher List</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<form asp-action="Index" method="get">

    <input type="text"
           name="searchString"
           placeholder="Search..." />

    <input type="submit"
           value="Submit"
           class="btn btn-primary" />

</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Room_Num)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Year)
            </th>
            
            <th>
                @Html.DisplayNameFor(model => model.Teacher)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Subject)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <button type="button"
                            class="btn btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#myModal-@item.Id">
                        @item.Teacher.FullName
                    </button>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Room_Num)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Year)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Subject.SubjectName)
                </td>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                }
            </tr>
            <div class="modal" id="myModal-@item.Id">
                <div class="modal-dialog modal-fullscreen">
                    <div class="modal-content">

                        <div class="modal-header">
                            <h4 class="modal-title">Year Details</h4>
                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"></button>
                        </div>

                        <div class="modal-body">
                            Name:@item.Teacher.FullName
                        </div>

                        <div class="modal-footer">
                            <button type="button"
                                    class="btn btn-danger"
                                    data-bs-dismiss="modal">
                                Back
                            </button>
                        </div>

                    </div>
                </div>
            </div>
        }
    </tbody>
</table>

                    
              

                

               