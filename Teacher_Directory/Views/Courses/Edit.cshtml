@model Teacher_Directory.Models.Course

@{
    ViewData["Title"] = "Edit";
}

<div class="my-3">
    <a asp-action="Index" class="back-link">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<h1>Edit Course</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group mb-2">
                <label asp-for="CourseName" class="control-label mb-2">Course Name</label>
                <input asp-for="CourseName" class="form-control" />
                <span asp-validation-for="CourseName" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="Year" class="control-label mb-2"></label>
                <input asp-for="Year" class="form-control" />
                <span asp-validation-for="Year" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="SubjectId" class="control-label mb-2"></label>
                <select asp-for="SubjectId" class="form-control" asp-items="ViewBag.SubjectId"></select>
                <span asp-validation-for="SubjectId" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="TeacherId" class="control-label mb-2">Teacher</label>
                <select asp-for="TeacherId" class="form-control" asp-items="ViewBag.TeacherId"></select>
                <span asp-validation-for="TeacherId" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="Room_Num" class="control-label mb-2">Room Number</label>
                <input asp-for="Room_Num" class="form-control" />
                <span asp-validation-for="Room_Num" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
