@model IEnumerable<Teacher_Directory.ViewModels.CourseIndexViewModels>

@{
    ViewData["Title"] = "Index";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Course List</h1>
    <a asp-action="Create" class="btn btn-success"> <i class="bi bi-plus-lg"></i> New Course</a>
</div>


<div class="card shadow border-0">

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-primary">

                    <tr>

                        <th>
                            Course Name
                        </th>
                        <th>
                            Year
                        </th>

                        <th>
                            Subject
                        </th>
                        <th>
                            Teacher
                        </th>
                        <th>
                            Room
                        </th>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <th>
                                Actions
                            </th>
                        }

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.OrderBy(c => c.Room_Num))
                    {
                        <tr>
                            <td>
                                @item.CourseName
                            </td>
                            <td>
                                @item.Year
                            </td>
                            <td>
                                @(item.Subject?.SubjectName ?? "N/A")
                            </td>
                            <td>
                                @item.Teacher.FullName
                            </td>
                            <td>
                                @item.Room_Num
                            </td>

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <td>

                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                        Details
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>