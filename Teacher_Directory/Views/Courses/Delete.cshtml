@model Teacher_Directory.Models.Course

@{
    ViewData["Title"] = "Delete";
}

<div class="my-3">
    <a asp-action="Index" class="back-link">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<h1>Delete Course</h1>

<h3>Please confirm that you want to delete this course.</h3>
<div>
    <h4>Course</h4>
    <hr />
    <div class="row">
        <div class="col-md-8">
            <dl class="row">
                <dt class="col-sm-2">
                    Course Name
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.CourseName)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Year)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Year)
                </dd>

                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Teacher)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Teacher.FullName)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Subject)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Subject.SubjectName)
                </dd>
                <dt class="col-sm-2">
                    Room Number
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Room_Num)
                </dd>
            </dl>
        </div>
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Delete" class="btn btn-danger" />
        </form>
    </div>
