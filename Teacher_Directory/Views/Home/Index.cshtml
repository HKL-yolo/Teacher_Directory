@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-5">

    <div class="text-center mb-5">

        <h1 class="display-3 fw-bold text-primary text-white">
            Teacher Directory
        </h1>

        <p class="lead text-muted mt-3 text-white">
            Welcome to the school teacher management system
        </p>

    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="container mt-5">
            <h3 class="text-center mb-4">Quick Access</h3>

            <div class="row g-4 justify-content-center">

                <div class="col-lg-3 col-md-6">
                    <a asp-controller="Teachers" asp-action="Index" class="text-decoration-none">
                        <div class="card h-100 shadow-sm border-0 text-center quick-access-card">
                            <div class="card-body py-4">
                                <i class="bi bi-people-fill fs-1 text-primary"></i>

                                <h4 class="mt-3 text-dark">Teachers</h4>

                                <p class="text-muted mb-0">
                                    Manage teacher profiles
                                </p>
                            </div>
                        </div>
                    </a>
                </div>

                <div class="col-lg-3 col-md-6">
                    <a asp-controller="Courses" asp-action="Index" class="text-decoration-none">
                        <div class="card h-100 shadow-sm border-0 text-center quick-access-card">
                            <div class="card-body py-4">
                                <i class="bi bi-journal-bookmark-fill fs-1 text-primary"></i>

                                <h4 class="mt-3 text-dark">Courses</h4>

                                <p class="text-muted mb-0">
                                    Manage teaching assignments
                                </p>
                            </div>
                        </div>
                    </a>
                </div>

                <div class="col-lg-3 col-md-6">
                    <a asp-controller="Subjects" asp-action="Index" class="text-decoration-none">
                        <div class="card h-100 shadow-sm border-0 text-center quick-access-card">
                            <div class="card-body py-4">
                                <i class="bi bi-book-fill fs-1 text-primary"></i>

                                <h4 class="mt-3 text-dark">Subjects</h4>

                                <p class="text-muted mb-0">
                                    Manage school subjects
                                </p>
                            </div>
                        </div>
                    </a>
                </div>

                <div class="col-lg-3 col-md-6">
                    <a asp-controller="Departments" asp-action="Index" class="text-decoration-none">
                        <div class="card h-100 shadow-sm border-0 text-center quick-access-card">
                            <div class="card-body py-4">
                                <i class="bi bi-building-fill fs-1 text-primary"></i>

                                <h4 class="mt-3 text-dark">Departments</h4>

                                <p class="text-muted mb-0">
                                    Manage academic departments
                                </p>
                            </div>
                        </div>
                    </a>
                </div>

            </div>
        </div>

    }
    else
    {
        <div class="row justify-content-center">

            <div class="col-md-8">

                <div class="card shadow-lg border-0 rounded-4">

                    <div class="card-body text-center p-5">

                        <img src="/images/school logo.png" style="width:120px;" class="mb-4" />

                        <h2 class="fw-bold mb-3">
                            Manage Teachers & Courses
                        </h2>

                        <p class="text-muted mb-4">
                            View teacher profiles, subjects,
                            classroom information, and course details.
                        </p>

                        <a class="btn btn-primary btn-lg px-5 py-3 rounded-pill shadow-sm" asp-area="" asp-controller="List"
                           asp-action="Index">

                            Start Exploring

                        </a>

                    </div>

                </div>

            </div>

        </div>
    }

</div>