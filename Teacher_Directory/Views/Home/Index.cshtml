@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-5">

    <div class="text-center mb-5">

        <h1 class="display-3 fw-bold text-primary">
            Teacher Directory
        </h1>

        <p class="lead text-muted mt-3">
            Welcome to the school teacher management system
        </p>

    </div>

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-body text-center p-5">

                    <img src="/images/school logo.png"
                         style="width:120px;"
                         class="mb-4" />

                    <h2 class="fw-bold mb-3">
                        Manage Teachers & Courses
                    </h2>

                    <p class="text-muted mb-4">
                        View teacher profiles, subjects,
                        classroom information, and course details.
                    </p>

                    <a class="btn btn-primary btn-lg px-5 py-3 rounded-pill shadow-sm"
                       asp-area=""
                       asp-controller="List"
                       asp-action="Index">

                        Start Exploring

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>