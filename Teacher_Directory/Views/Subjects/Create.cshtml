@model Teacher_Directory.Models.Subject

@{
    ViewData["Title"] = "Create";
}

<div class="my-3">
    <a asp-action="Index" class="back-link">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>
<h1>Add New Subject</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-2">
                <label asp-for="SubjectName" class="control-label mb-2">Subject Name</label>
                <input asp-for="SubjectName" class="form-control" />
                <span asp-validation-for="SubjectName" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="DepartmentId" class="control-label mb-2"></label>
                <select asp-for="DepartmentId" class="form-control" asp-items="ViewBag.DepartmentId"></select>
            </div>
            <div class="form-group mb-2">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
