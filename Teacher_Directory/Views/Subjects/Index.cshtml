@model IEnumerable<Teacher_Directory.ViewModels.SubjectIndexViewModels>

@{
    ViewData["Title"] = "Index";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Subject List</h1>
    <a asp-action="Create" class="btn btn-success"> <i class="bi bi-plus-lg"></i> New Subject</a>
</div>

<div class="card shadow border-0">

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-primary">

                    <tr>

                        <th>
                            Subject Name
                        </th>
                        <th>
                            Department
                        </th>

                        <th>
                            No. of Course
                        </th>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <th>
                                Actions
                            </th>
                        }

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.OrderBy(s => s.DepartmentName))
                    {
                        <tr>
                            <td>
                                @item.SubjectName
                            </td>

                            <td>
                                @item.DepartmentName
                            </td>
                            <td>
                                @item.CourseCount
                            </td>

							
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <td>

                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                        Details
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>


