@model Teacher_Directory.Models.Subject

@{
    ViewData["Title"] = "Delete";
}

<div class="my-3">
    <a asp-action="Index" class="back-link">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div>
    <h1>Delete Subject</h1>
    <h3>Please confirm that you want to delete this subject.</h3>
</div>

<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">
            Subject Name
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SubjectName)
        </dd>
        <dt class="col-sm-2">
            Department
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Department.DepartmentName)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
    </form>
</div>

