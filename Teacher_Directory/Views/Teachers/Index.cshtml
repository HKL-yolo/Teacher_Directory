@model IEnumerable<Teacher_Directory.Models.Teacher>

@{
    ViewData["Title"] = "Index";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Teacher List</h1>
    <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-lg"></i> New Teacher</a>
</div>


<div class="card shadow border-0">

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-primary">

                    <tr>

                        <th>
                            Code
                        </th>
                        <th>
                            Teacher
                        </th>

                        <th>
                            Gender
                        </th>

                        <th>
                            Email
                        </th>

                        <th>
                            Department
                        </th>
                        <th>
                            Position
                        </th>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <th>
                                Actions
                            </th>
                        }

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.OrderBy(t => t.FullName))
                    {
                        <tr>

                            <!-- Teacher -->
                            <td>
                                @item.Teachercode
                            </td>
                            <td>

                                <div class="d-flex align-items-center">

                                    @if (!string.IsNullOrEmpty(item.PhotoURL))
                                    {
                                        <img src="@item.PhotoURL" style="
                                        width:45px;
                                        height:45px;
                                        border-radius:50%;
                                        object-fit:cover;
                                        margin-right:10px;" />
                                    }

                                    <span class="fw-semibold">
                                        @item.FullName
                                    </span>

                                </div>

                            </td>

                            <!-- Gender -->
                            <td>
                                @item.Gender
                            </td>

                            <!-- Email -->
                            <td>
                                @item.Email
                            </td>

                            <!-- Department -->
                            <td>
                                @(item.Department?.DepartmentName ?? "N/A")
                            </td>

                            <!-- Position -->
                            <td>
                                @item.Position
                            </td>

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <td>

                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                        Details
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>

                                </td>
                            }

                        </tr>


                    }

                </tbody>

            </table>
        </div>
    </div>
</div>